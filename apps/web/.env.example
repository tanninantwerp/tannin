# Copy to .env.local and fill in from the Supabase dashboard
# (Project settings → API). The anon key is safe in the browser: row-level
# security in supabase/migrations/0001_init.sql is what actually guards the data.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Never prefix with NEXT_PUBLIC_ — it bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Where this deployment lives ──────────────────────────────────────────────
# Leave it unset on Vercel. Vercel sets its own deployment variables and the
# site works them out: the project's domain on production, this deployment's
# own URL on a preview, localhost when you run it here. Attaching ta-nnin.be to
# the project is what makes it the live site — no code change, no variable.
#
# Set it only to override that, e.g. a staging host behind a proxy. It decides
# the canonical tags, the sitemap, and the cancel link in every booking email,
# so a wrong value is silent until a guest clicks.

NEXT_PUBLIC_SITE_URL=

# ── Email ────────────────────────────────────────────────────────────────────
# SMTP, for the guest's booking receipt and confirmation. Server only. Staff
# are not emailed at all — a waiting request shows in the admin, live.
#
# Leave these unset and the site still works: bookings save and appear in the
# admin, the confirmation screen simply stops promising an email. All four of
# SMTP_HOST/USER/PASS and BOOKING_FROM_EMAIL must be set before anything sends.
#
# SMTP_HOST/PORT/USER  from the provider. Brevo's free tier: smtp-relay.brevo.com,
#                      port 587, and the login + generated SMTP key shown under
#                      SMTP & API.
# SMTP_PASS            the SMTP key. Secret — never commit it.
# BOOKING_FROM_EMAIL   must EXACTLY match a sender verified in the provider, or
#                      every send is rejected. A freemail sender (…@gmail.com)
#                      works but is prone to spam-filtering; an authenticated
#                      domain (bookings@ta-nnin.be) is the deliverable version.

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
BOOKING_FROM_EMAIL=tannin.reservation@gmail.com

# ── Booking throttle ─────────────────────────────────────────────────────────
# Any long random string, kept secret. It salts the hash of the caller's IP
# that the booking throttle counts against, so the database holds no addresses
# and there is nothing there to disclose or leak.
#
# Leave it unset and bookings still work — the throttle falls back to counting
# by email address alone, which stops a stuck retry loop but not somebody
# varying the address. Set it in production. An unsalted hash of an IP is not
# anonymous: the whole IPv4 space can be hashed and looked up in minutes, which
# is why an empty salt turns the IP key off rather than weakening it.
#
#   openssl rand -hex 32

THROTTLE_SALT=


# ── On-demand ISR revalidation ────────────────────────────────────────────────
# When the admin saves or deletes a social post it calls POST /api/revalidate
# on this app to flush the homepage ISR cache immediately. Set this to the same
# random string as REVALIDATE_SECRET on the admin Vercel project.
#
#   openssl rand -hex 24

REVALIDATE_SECRET=

# ── Gift vouchers (Stripe) ───────────────────────────────────────────────────
# Leave these unset and /gift still shows the voucher, but says it is sold at
# the bar. The Stripe keys below plus SUPABASE_SERVICE_ROLE_KEY switch online sales on.
#
# STRIPE_SECRET_KEY      Stripe dashboard → Developers → API keys. Starts
#                        sk_test_ in test mode, sk_live_ for real money. Secret.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
#                        Same page, the publishable key: pk_test_ or pk_live_,
#                        matching the secret key. Public; it draws the card
#                        fields on /gift. Built into the page, so redeploy
#                        after changing it.
# STRIPE_WEBHOOK_SECRET  Developers → Webhooks → add an endpoint at
#                        https://<this site>/api/stripe/webhook listening to
#                        checkout.session.completed,
#                        checkout.session.async_payment_succeeded,
#                        checkout.session.expired and charge.refunded.
#                        Its signing secret starts whsec_. Secret.
# ADMIN_URL              The admin's address, e.g. https://admin.ta-nnin.be.
#                        Optional: it is what the QR on the back of an online
#                        voucher opens. Without it the card carries only the code.

STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
ADMIN_URL=
