# Same Supabase project as the website. Copy to .env.local.

# Safe in the browser — row-level security is what guards the data, and every
# table rejects this key unless the signed-in user has a row in `staff`.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Never prefix this with NEXT_PUBLIC_.
# It bypasses row-level security completely and is only used by /api/staff to
# create and delete logins, which the anon key is not permitted to do.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Email ────────────────────────────────────────────────────────────────────
# The same SMTP settings as the website. The admin sends the confirmed/declined
# email to the guest when staff press the button; without it the status still
# changes and the board says plainly that no email went out. Staff themselves
# are never emailed — a waiting request shows in the admin, live.

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
BOOKING_FROM_EMAIL=tannin.reservation@gmail.com

# ── Booking reminders ────────────────────────────────────────────────────────
# Vercel Cron hits /api/cron/reminders once a day (see vercel.json). Set this
# to any long random string and Vercel attaches it as the request's bearer
# token automatically — without it the route still runs, just unauthenticated.
CRON_SECRET=

# ── Instagram sync ───────────────────────────────────────────────────────────
# Optional. Enables automatic sync of recent Instagram posts to the social strip.
#
# To set up:
#  1. Go to https://developers.facebook.com/ → create an App (type: Business).
#  2. Add the "Instagram" product to the app.
#  3. In Graph API Explorer, select your app and generate a User Access Token
#     with these permissions: instagram_basic, pages_show_list (for Business
#     accounts) or just instagram_basic (for Creator accounts).
#  4. Paste that token into the Connect panel in the Social admin — the admin
#     exchanges it for a 60-day long-lived token automatically.
#  5. Set APP_ID and APP_SECRET below so the cron can refresh the token daily.
#     Without them the cron still syncs but cannot renew the token — you'd need
#     to reconnect manually every 60 days.
#
# Token storage: lives in the app_settings table (not here), updated on each sync.
# Disconnect: the Disconnect button in the Social admin clears those rows.

INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ── Where the *public site* lives ────────────────────────────────────────────
# The confirmed/declined email carries the guest's own manage link, and that
# link points at the website — not at this admin. So this is the website's
# origin, which is the one thing here that is not an admin address.
#
# Set it on any deployment where the site is not yet on its own domain.
# Defaults to https://ta-nnin.be.

# NEXT_PUBLIC_SITE_URL=https://your-site-deployment.vercel.app

# ── On-demand ISR revalidation ────────────────────────────────────────────────
# After saving or deleting a social post, the admin POSTs to the web app's
# /api/revalidate to flush the homepage cache so changes appear immediately.
#
# Set REVALIDATE_SECRET to a random string, and the same value on the web Vercel
# project. NEXT_PUBLIC_WEB_URL defaults to https://ta-nnin.be.
#
#   openssl rand -hex 24

REVALIDATE_SECRET=
# NEXT_PUBLIC_WEB_URL=https://your-web-deployment.vercel.app
